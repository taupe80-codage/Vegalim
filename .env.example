# ══════════════════════════════════════════════════════════════════════════════
# ALIM — variables d'environnement
#
#   cp .env.example .env        (à la RACINE du projet : c'est là que .env est lu)
#
# Ne jamais committer .env. Les noms ci-dessous sont exactement ceux lus par
# backend/core/config.py et docker-compose.yml.
# ══════════════════════════════════════════════════════════════════════════════

# ── Environnement ────────────────────────────────────────────────────────────
# production | development
# Non défini → comportement « development » (Swagger /docs et /metrics ouverts,
# secrets non exigés) SANS exposer les jetons de réinitialisation de mot de passe,
# qui ne sont renvoyés dans la réponse qu'avec APP_ENV=development explicite.
# docker-compose force APP_ENV=production.
APP_ENV=development

# ── Sécurité (OBLIGATOIRES en production : démarrage bloqué sinon) ────────────
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALTH_DATA_KEY=

# Emails autorisés sur /admin/* (en plus d'une clé API valide), séparés par des virgules.
# Ces comptes modèrent aussi les recettes proposées (page #/moderation, connexion
# habituelle). Vide = administration et modération désactivées.
ADMIN_EMAILS=

# E-mails (statut des recettes proposées, alerte de modération). Sans SMTP_HOST,
# rien n'est envoyé : les messages sont seulement journalisés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex. « ALIM <no-reply@mondomaine.fr> »
SMTP_FROM=
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
# Adresse publique de l'interface, pour les liens des e-mails
APP_BASE_URL=http://localhost:8000/ui

# Jeton exigé pour /metrics en production (header X-Metrics-Token)
METRICS_TOKEN=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# « * » = développement uniquement. Production : https://alim.app,https://www.alim.app
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Base de données ──────────────────────────────────────────────────────────
# Vide = SQLite local (alim_dev.db). docker-compose construit DATABASE_URL lui-même.
DATABASE_URL=
POSTGRES_USER=alim
POSTGRES_PASSWORD=
POSTGRES_DB=alim_db

# ── Redis (rate limiting partagé entre workers) ──────────────────────────────
REDIS_URL=

# ── Docker / Caddy ───────────────────────────────────────────────────────────
ALIM_DOMAIN=localhost
API_PORT=8000
# URL de l'API injectée dans le build Vite (vide = même origine que le frontend)
VITE_API_URL=

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Scripts ──────────────────────────────────────────────────────────────────
# USDA_API_KEY=
# UNSPLASH_ACCESS_KEY=
