# ══════════════════════════════════════════════════════════════════
# Configuration ALIM v5 — Variables d'environnement
# Copier ce fichier vers .env et remplacer TOUTES les valeurs
# Ne jamais committer .env dans git
# ══════════════════════════════════════════════════════════════════

# ── JWT — OBLIGATOIRE en production ───────────────────────────────
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGEZ-MOI-cle-secrete-production

# ── Chiffrement données santé — OBLIGATOIRE en production (RGPD Art. 9) ──────
# Chiffre cycle_phase et health_goal en base de données
# Générer : python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HEALTH_DATA_KEY=

# ── Base de données PostgreSQL ─────────────────────────────────────
# Fallback SQLite si absent (développement uniquement)
# DATABASE_URL=postgresql://user:password@localhost:5432/alim_db

# ── CORS — OBLIGATOIRE en production ──────────────────────────────
# Laisser vide ou * = dev seulement (warning au démarrage)
# CORS_ORIGINS=https://monapp.com,https://api.monapp.com
CORS_ORIGINS=*

# ── Redis — rate limiting multi-process ───────────────────────────
# Recommandé avec plusieurs workers Uvicorn (sinon limite ÷ N workers)
# REDIS_URL=redis://localhost:6379/0

# ── Logs ──────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
