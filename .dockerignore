# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Environnements virtuels ───────────────────────────────────────────────────
venv/
.venv/
env/

# ── Variables d'environnement ─────────────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example est utile dans l'image → non exclu

# ── Frontend : node_modules et build ─────────────────────────────────────────
# node_modules est reconstruit dans le stage frontend-build
frontend/node_modules/
# dist/ sera généré dans le stage frontend-build
frontend/dist/

# ── Sources brutes nutrition (très grands fichiers — ~500 Mo) ─────────────────
# Montés via volume au runtime, jamais baked dans l'image
backend/data/nutrition/raw/

# ── Données runtime et logs ───────────────────────────────────────────────────
# Montés via bind mount — ne pas dupliquer dans l'image
backend/data/product/
backend/data/logs/
backend/data/user_profiles/
backend/users/history/

# ── Base de données SQLite dev ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Backups et archives ───────────────────────────────────────────────────────
backend/data/nutrition/processed/archive/
backend/data/nutrition/reference/*.bak.json
*.zip
*.bak

# ── Documentation et fichiers de dev ─────────────────────────────────────────
docs/
*.md
*.html
*.docx
*.pdf
*.svg
# *.txt exclu SAUF requirements*.txt (indispensables au build Python)
*.txt
!requirements.txt
!requirements-dev.txt

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.claude/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Tests ─────────────────────────────────────────────────────────────────────
tests/

# ── Scripts : logs et essais (scripts/recipes/ reste dans l'image : rebuild
#    du registre et des graphes via le service pipeline) ────────────────────────
scripts/recipes/logs/
scripts/recipes/archives/
scripts/archives/
scripts/ingredients/_scripts/

# ── Sauvegardes et copies de travail des données (voir .gitignore) ───────────
# Les motifs .dockerignore sans ** ne s'appliquent qu'à la racine.
**/*.bak
**/*.bak[0-9]
**/*.corrupt_*
**/__pycache__/
.alim_zip_extract/
backups/
backend/data/_archive/
backend/data/backups/
backend/data/ingredients/archives/
backend/data/nutrition/processed/nutrition_v2_backup_*.json
backend/data/nutrition/processed/nutrition_v2_rebuilt.json
backend/data/nutrition/processed/*.zip
backend/data/nutrition/reference/nutrition_corrected.json
backend/data/nutrition/reference/nutrition_patched_v8.json
backend/data/nutrition/reference/ontology_v6*.json
backend/data/nutrition/reference/taxonomy_session_*.json
backend/data/recipes/recipes_chef_rewrite_smart*.json
backend/data/recipes/recipes.rewrite_progress_smart.json
backend/data/*.html
backend/data/*.js

# ── Hors application (dossiers locaux à la racine) ───────────────────────────
premiere_mouture/
outputs/
launcher/
*.exe
*.xlsx
*.bat
proxy_data.json
