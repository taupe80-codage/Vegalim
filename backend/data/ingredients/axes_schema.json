    "splits_required": [
      "conditionnement → packaging (commercial, conserve, préemballé, sous vide, tablette) + thermal_state (UHT, pasteurisé, rayon frais, sous pression)"
    ],
    "value_migrations": [
      "teneur_MG : valeurs numériques à convertir en catégories fat_content (entier, demi-écrémé, écrémé déjà présents)",
      "traitement : valeurs array-sérialisées ['blanchi', 'non blanchi'] → séparer en valeurs multiples",
      "traitement : écrémé, demi-écrémé, allégé en gras → fat_content",
      "traitement : faible en sodium, réduit en sodium → sodium",
      "traitement : nature → seasoning:plain",
      "traitement : instantané → form:instant (ou treatment:instant selon contexte)"
    ],
