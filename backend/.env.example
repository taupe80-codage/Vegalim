# ══════════════════════════════════════════════════════════════════
# Configuration ALIM v5 — Variables d'environnement
# Copier ce fichier vers .env et remplacer TOUTES les valeurs
# Ne jamais committer .env dans git
# ══════════════════════════════════════════════════════════════════

# Mode d'exécution
ENVIRONMENT=development

# Clés de Sécurité (à définir obligatoirement en production)
SECRET_KEY=votre_cle_secrete_ici
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 

# Cryptographie des Tiers (si utilisé pour des données sensibles)
HEALTH_DATA_KEY=votre_cle_de_chiffrement_sante_ici

# Autorisations
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Base de données PostgreSQL ─────────────────────────────────────
# Fallback SQLite si absent (développement uniquement)
# DATABASE_URL=postgresql://user:password@localhost:5432/alim_db

# ── CORS — OBLIGATOIRE en production ──────────────────────────────
# Laisser vide ou * = dev seulement (warning au démarrage)
# CORS_ORIGINS=https://monapp.com,https://api.monapp.com
CORS_ORIGINS=*

# ── Redis — rate limiting multi-process ───────────────────────────
# Recommandé avec plusieurs workers Uvicorn (sinon limite ÷ N workers)
# REDIS_URL=redis://localhost:6379/0

# ── Logs ──────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Scripts hors backend (download_recipe_images.py) ──────────────
# Cle gratuite sur unsplash.com/developers
# UNSPLASH_ACCESS_KEY=votre_cle_unsplash_ici
